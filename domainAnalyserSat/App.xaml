<Application x:Class="domainAnalyserSat.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:domainAnalyserSat"
             StartupUri="LoginWindow.xaml">
    <Application.Resources>
         
       <!-- Palette -->
       <!--All colours will be declared here to resuability -->

        
        <!--Surface Colours, Layers out the background through toned colours to create depth and improved immersion-->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0C0F10"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1D2021"/>
        <SolidColorBrush x:Key="SurfaceHighBrush"      Color="#272A2B"/>
        <SolidColorBrush x:Key="OverlayBrush"          Color="#323536"/>
        <SolidColorBrush x:Key="InputBackgroundBrush"  Color="#080A0B"/>
        <SolidColorBrush x:Key="ZebraStripeBrush"      Color="#191C1D"/>
        
        <!--Text Colours, Used for text and icons to create contrast against the background-->
        <SolidColorBrush x:Key="OnSurfaceBrush"        Color="#E1E3E4"/>
        <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="#BACAC5"/>

        <!-- Outlines (low-contrast borders define  the component edges) -->
        <SolidColorBrush x:Key="OutlineBrush"          Color="#3C4A46"/>
        <SolidColorBrush x:Key="OutlineFocusBrush"     Color="#859490"/>

        <!-- Primary (teal) - success, positive trends, primary actions-->
        <SolidColorBrush x:Key="PrimaryBrush"          Color="#2DD4BF"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush"     Color="#57F1DB"/>
        <SolidColorBrush x:Key="OnPrimaryBrush"        Color="#003731"/>

        <!-- Secondary (sunset orange) - warnings, cuationary data points -->
        <SolidColorBrush x:Key="SecondaryBrush"        Color="#EC6A06"/>
        <SolidColorBrush x:Key="SecondaryLightBrush"   Color="#FFB690"/>
        <SolidColorBrush x:Key="OnSecondaryBrush"      Color="#552100"/>

            <!-- Sate Colours  -->
        <SolidColorBrush x:Key="ErrorBrush"            Color="#FFB4AB"/>
        <SolidColorBrush x:Key="PositiveBrush"         Color="#2DD4BF"/>
        <SolidColorBrush x:Key="NegativeBrush"         Color="#FF6B6B"/>


        <!--Fonts -->
        <FontFamily x:Key="InterFont">Inter, Segoe UI </FontFamily>
        <FontFamily x:Key="MonoFont">JetBrains Mono, Cascadia Mono, Consolas</FontFamily>
        
        
        <!--Pipline Brushes-->

        <SolidColorBrush x:Key="StepPanelBrush"          Color="#111415"/>
        <!-- stepper container bg -->
        <SolidColorBrush x:Key="StepRailBrush"           Color="#1F2426"/>
        <!-- default rail + border -->
        <SolidColorBrush x:Key="StepLockedOutlineBrush"  Color="#33393B"/>
        <!-- locked circle outline -->
        <SolidColorBrush x:Key="StepMutedBrush"          Color="#4B5457"/>
        <!-- locked numeral/label/lock -->
        <SolidColorBrush x:Key="StepActiveBrush"         Color="#F97316"/>
        <!-- active circle + underline -->
        <SolidColorBrush x:Key="OnStepActiveBrush"       Color="#4A1B0C"/>
        <!-- numeral on active circle -->
        <SolidColorBrush x:Key="StepCompleteLabelBrush"  Color="#9FE1CB"/>
        <!-- completed label (dim teal) -->
        <SolidColorBrush x:Key="OnStepCompleteBrush"     Color="#04342C"/>
        <!-- check glyph on teal circle -->
        <SolidColorBrush x:Key="StepCountBrush"          Color="#6B7280"/>
        <!-- muted inline count -->
        <SolidColorBrush x:Key="StepRejectedBrush"       Color="#E24B4A"/>
        <!-- N rejected (later) -->


        <!--Control styles -->
       
        
        <!--TextInputs -->
        <Style x:Key="TerminalTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value ="{StaticResource OnSurfaceBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{StaticResource InputBackgroundBrush}"
                                BorderBrush="{StaticResource OutlineBrush}"
                                BorderThickness="1" CornerRadius="4">
                            <!--Cladue Suggstion, use scrollviewer to manage text overflows -->
                            <ScrollViewer x:Name="PART_ContentHost"  
                                                                     
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                                                       
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource OutlineFocusBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            
                        </ControlTemplate.Triggers>
                                                                      
                    </ControlTemplate>
                                  
                               
                       
                             
                </Setter.Value>
               
          </Setter>             
              
        </Style>
              
        <!--Primary Button Styles-->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>



                    </ControlTemplate>
                              
                </Setter.Value>
                   
            </Setter>
           
        </Style>

        <!--Secondary Button Styles -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource OutlineBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            
                        </ControlTemplate.Triggers>
                            
                    </ControlTemplate>
                                     
                               
                </Setter.Value>
                
             
            </Setter>
            
        </Style>


        <!--Links-->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"/>



                    </ControlTemplate>
                    
                    
                </Setter.Value>
                
                
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource PrimaryHoverBrush}"/>
                </Trigger>
            </Style.Triggers>



        </Style>


        <!--Password Input-->
        <Style x:Key ="TerminalPassBox" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="bd"
                            Background="{StaticResource InputBackgroundBrush}"
                            BorderBrush="{StaticResource OutlineBrush}"
                            BorderThickness="1" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource OutlineFocusBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            

                        </ControlTemplate.Triggers>
                            




                    </ControlTemplate>
                </Setter.Value>
                
                



            </Setter>
        
               
               
        </Style>
        
        <!--Card COntiner - use for every surface panel -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="24"/>
        </Style>
        
        <!-- Left side bar navi items -->
        <Style x:Key="SidebarNavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariantBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center" Margin="14,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHighBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!---Top navi items  -->
        <Style x:Key="TopNavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariantBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>



        
      <!--Selected sidebar nav menu -->
        <Style x:Key="sidebarNavBtnActive" TargetType="Button"
            BasedOn="{StaticResource SidebarNavButton}">
            <Setter Property="Background" Value="{StaticResource SurfaceHighBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>



        </Style>

        
        
        <!--Pipline-->
        
                  
            


















    
       

        















    </Application.Resources>
</Application>
