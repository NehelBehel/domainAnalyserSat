<Window x:Class="domainAnalyserSat.createAccount"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:domainAnalyserSat"
        mc:Ignorable="d"
        Title="Domain Analyser - Create Account" Height="720" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource InterFont}">
    <Grid>
        
        <!--Sign up -->
        <Border Width="380"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1"
                CornerRadius="8" Padding="32,36">

            <StackPanel>
                <TextBlock Text="Create Account"
                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                           Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="Sign up"
                           FontSize="24" 
                           FontWeight="Bold"
                           Foreground="{StaticResource OnSurfaceBrush}"
                           Margin="0,8,0,0"/>

                <TextBlock Text="Create a local account"
                           FontSize="13"
                           Foreground="{StaticResource OnSurfaceVariantBrush}"
                           Margin="0,4,0,28"/>
                <!--Username-->
                <Label Content="Username"
                       Target="{Binding ElementName=txtUsername}"
                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                       FontSize="12" Padding="0,0,0,6"/>
                <TextBox x:Name="txtUsername"
                         Style="{StaticResource TerminalTextBox}"
                         TabIndex="0"
                         AutomationProperties.Name="Username"/>
                <!--Allows assistive services to read app (Blind people) -->

                <!--Password-->
                <Label Content="Password"
                       Target="{Binding ElementName=pwdPassword}"
                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                       FontSize="12" Padding="0,18,0,6"/>
                <TextBox x:Name="pwdPassword"
                         Style="{StaticResource TerminalTextBox}"
                         TabIndex="1"
                         AutomationProperties.Name="Password"/>
                <TextBlock Text="At least 8 characters."
                           Foreground="{StaticResource OnSurfaceVariantBrush}"
                           FontSize="11" Margin="0,6,0,0"/>

                <!--Password Confirmation-->
                <Label Content="Confirm Password"
                       Target="{Binding ElementName=pwdPasswordConfirm}"
                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                       FontSize="12" Padding="0,18,0,6"/>
                <PasswordBox x:Name="pwdConfirm"
                             Style="{StaticResource TerminalPassBox}"
                             TabIndex="2"
                             AutomationProperties.Name="Confirm Password"/>
                <!--Error message - remains hidden until required  -->
                <TextBlock x:Name="lblError"
                           Foreground="{StaticResource ErrorBrush}"
                           FontSize="12" TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Margin="0,14,0,0"/>
                <!-- Create account (Enter key triggers via IsDefault) -->
                <Button x:Name="btnCreateAccount"
                        Content="Create Account"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True" TabIndex="3"
                        Margin="0,24,0,0"
                        Click="btnCreateAccount_Click"/>

                <!--Return to login-->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0">
                    <TextBlock Text="Already have an account?"
                               Foreground="{StaticResource OnSurfaceVariantBrush}"
                               FontSize="13" VerticalAlignment="Center"/>
                    <Button x:Name="btnReturnToLogin"
                            Content="Log in"
                            Style="{StaticResource LinkButton}"
                            TabIndex="4" Margin="6,0,0,0"
                            Click="btnReturnToLogin_Click"/>






                </StackPanel>
            </StackPanel>

        </Border>


        










    </Grid>
</Window>
