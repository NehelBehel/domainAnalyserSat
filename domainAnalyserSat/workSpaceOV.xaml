<UserControl x:Class="domainAnalyserSat.workSpaceOV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:domainAnalyserSat"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">   
            <StackPanel Margin="32">
                
            <TextBlock Text="Workspace Overview" FontSize="26"
              FontWeight="Bold"
              Foreground="{StaticResource OnSurfaceBrush}"/>

                <TextBlock Text="Welcome Back "
              FontSize="13"
              Foreground="{StaticResource OnSurfaceVariantBrush}"
              Margin="0,4,0,24"/>


            
                     <!--Import-->


            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /> <!---card -->
                    <ColumnDefinition Width="24" /><!---gutter -->
                    <ColumnDefinition Width="*" /><!---card -->
                    
                    
                 
                </Grid.ColumnDefinitions>
               
                <!--Import card-->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Import New List "
                                  FontSize="18" FontWeight="SemiBold"
                                  Foreground="{StaticResource OnSurfaceBrush}"/>
                        <TextBlock Text="Upload a CSV or TXT list to begin domain analysis"
                                  FontSize="13" TextWrapping="Wrap"
                                  Foreground="{StaticResource OnSurfaceVariantBrush}"
                                  Margin="0,8,0,20"/>
                        <!--Future fix:Button could be a big larger for select source-->
                        <Button Content="Select Source" 
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left" Padding="20,0"/>
                        


                    </StackPanel>
                    
                    
                    
                    
                </Border>
                        <!--Summary stat card-->

                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Portfolio Summary"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource OnSurfaceBrush}"/>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />  
                                <ColumnDefinition Width="*" />
                                

                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="0" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="28" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="Domains Analysed" FontSize="12"
                                                   Foreground="{StaticResource OnSurfaceVariantBrush}"/>
                            </StackPanel>


                            <StackPanel Grid.Column="1">
                                <TextBlock Text="0" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="28" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="Watchlist" FontSize="12"
                                                   Foreground="{StaticResource OnSurfaceVariantBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="0" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="28" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="Sessions Saved" FontSize="12"
                                                   Foreground="{StaticResource OnSurfaceVariantBrush}"/>
                            </StackPanel>



                        </Grid>
                                   

                    </StackPanel>
                    
                </Border>
                        
                
            </Grid>
            
           
            
           <!--Recent Sessions-->

            <TextBlock Text="Recent Sessions"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource OnSurfaceBrush}"
                               Margin="0,32,0,12"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="No saved sessions yet"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource OnSurfaceBrush}"/>
                        <TextBlock Text="ID: —" FontFamily="{StaticResource MonoFont}"
                                           FontSize="12" Foreground="{StaticResource OnSurfaceVariantBrush}"
                                           Margin="0,6,0,0"/>
                        <TextBlock Text="Start a New Analysis to create one."
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource OnSurfaceVariantBrush}"
                                           Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="No saved sessions yet"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource OnSurfaceBrush}"/>
                        <TextBlock Text="ID: —" FontFamily="{StaticResource MonoFont}"
                                           FontSize="12" Foreground="{StaticResource OnSurfaceVariantBrush}"
                                           Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="No saved sessions yet"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource OnSurfaceBrush}"/>
                        <TextBlock Text="ID: —" FontFamily="{StaticResource MonoFont}"
                                           FontSize="12" Foreground="{StaticResource OnSurfaceVariantBrush}"
                                           Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>









            </Grid>













            </StackPanel>
        </ScrollViewer>
        
        
    </Grid>
    
    
    
    
    
    
    
    
</UserControl>
