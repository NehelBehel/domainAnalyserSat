<Window x:Class="domainAnalyserSat.LoginWIndow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:domainAnalyserSat"
        mc:Ignorable="d"
        Title="LoginWIndow" Height="640" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource  BackgroundBrush}"
        FontFamily="{StaticResource InterFont}">

    <Grid>

        <!-- Centred login card -->
        <Border Width="380"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1"
                CornerRadius="8" Padding="32,36">
            <StackPanel>

                <!-- Brand line (mono, terminal-style) -->
                <TextBlock Text="DOMAIN INVESTMENT ANALYSER"
                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                           Foreground="{StaticResource PrimaryBrush}"/>

                <TextBlock Text="Sign in"
                           FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource OnSurfaceBrush}"
                           Margin="0,8,0,0"/>

                <TextBlock Text="Access your workspace."
                           FontSize="13"
                           Foreground="{StaticResource OnSurfaceVariantBrush}"
                           Margin="0,4,0,28"/>

                <!-- Username -->
                <Label Content="Username"
                       Target="{Binding ElementName=txtUsername}"
                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                       FontSize="12" Padding="0,0,0,6"/>
                <TextBox x:Name="txtUsername"
                         Style="{StaticResource DomainTextBox}"
                         TabIndex="0"
                         AutomationProperties.Name="Username"
                         TextChanged="inputChanged"/>


                <!-- Password -->
                <Label Content="Password"
                       Target="{Binding ElementName=pwdPassword}"
                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                       FontSize="12" Padding="0,18,0,6"/>
                <PasswordBox x:Name="pwdPassword"
                             Style="{StaticResource TerminalPassBox}"
                             TabIndex="1"
                             AutomationProperties.Name="Password"
                             PasswordChanged="inputChanged"/>

                <!-- Error / status message (hidden until needed) -->
                <TextBlock x:Name="lblError"
                           Foreground="{StaticResource ErrorBrush}"
                           FontSize="12" TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Margin="0,14,0,0"/>

                <!-- Log in (Enter key triggers this via IsDefault) -->
                <Button x:Name="btnLogin"
                        Content="Log In"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True" TabIndex="2"
                        Margin="0,24,0,0"
                        Click="btnLogin_Click"/>

                <!-- Create account -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0">
                    <TextBlock Text="No account yet?"
                               Foreground="{StaticResource OnSurfaceVariantBrush}"
                               FontSize="13" VerticalAlignment="Center"/>
                    <Button x:Name="btnCreateAccount"
                            Content="Create one"
                            Style="{StaticResource LinkButton}"
                            TabIndex="3" Margin="6,0,0,0"
                            Click="btnCreateAccount_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>


        <!--TEMP SKIP LOGIN FOR DEVELOPMENT, REMOVE BEFORE FINAL SUBMISSION -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="0,591,0,0"
                    Height="23">
            <Button x:Name="btnSkipLogin"
                    Content="Skip Login"
                    Style="{StaticResource LinkButton}"
                    TabIndex="4"
                    Click="btnSkipLogin_Click"/>

        </StackPanel>





    </Grid>
</Window>
