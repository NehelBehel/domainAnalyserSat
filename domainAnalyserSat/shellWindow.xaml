<Window x:Class="domainAnalyserSat.shellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:domainAnalyserSat"
        mc:Ignorable="d"
         d:DesignHeight="600" d:DesignWidth="960"
 Background="{StaticResource BackgroundBrush}"
 FontFamily="{StaticResource InterFont}"
 Title="windowShell">
    <Grid>


        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />


        </Grid.ColumnDefinitions>


        <!-- Sidebar -->
        <Border Grid.Column="0"    
            BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="16,24">
                <!-- Brand -->
                <StackPanel>

                    <TextBlock Text="Domain Investment"
                           FontFamily="{StaticResource MonoFont}" FontSize="13"
                           Foreground="{StaticResource PrimaryBrush}"/>

                    <TextBlock Text="Aanalyser"
                           FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"/>


                </StackPanel>

                <!--Primary Action-->


                <Button x:Name="btnNewAnalysis" Content="+  New Analysis"
                    Style="{StaticResource PrimaryButton}" Margin="0,24"
                    Click="btnNewAnalysis_Click"/>

                <!-- Nav -->
                <Button x:Name="btnNavDashboard" Content="Dashboard"
                    Style="{StaticResource SidebarNavButton}"
                    Click="btnNavDashboard_Click"/>
                <Button x:Name="btnNavWatchlist" Content="Watchlist"
                    Style="{StaticResource SidebarNavButton}"
                    Click="btnNavWatchlist_Click"/>
                <Button x:Name="btnNavSession" Content="Session"
                    Style="{StaticResource SidebarNavButton}"
                    Click="btnNavSession_Click"/>


            </StackPanel>




        </Border>


        <!--Main Area-->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!--Top nav bar-->
            <Border Grid.Row="0" Padding="32,18"
                BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnTopImport" Content="Import"
                        Style="{StaticResource TopNavButton}"
                        Click="btnTopImport_Click"/>
                    <Button x:Name="btnTopAnalysis" Content="Analysis"
                        Style="{StaticResource TopNavButton}" Margin="28,0,0,0"
                        Click="btnTopAnalysis_Click"/>
                    <Button x:Name="btnTopValidate" Content="Validate"
                        Style="{StaticResource TopNavButton}" Margin="28,0,0,0"
                        Click="btnTopValidate_Click"/>
                </StackPanel>
            </Border>
            <!-- Swappable content region -->
            <ContentControl x:Name="contentHost" Grid.Row="1"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"/>




        </Grid>




    </Grid>


















   
</Window>
