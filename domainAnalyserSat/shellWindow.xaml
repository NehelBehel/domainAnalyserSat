<Window x:Class="domainAnalyserSat.shellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:domainAnalyserSat"
        mc:Ignorable="d"
         d:DesignHeight="600" d:DesignWidth="960"
 Background="{StaticResource BackgroundBrush}"
 FontFamily="{StaticResource InterFont}"           
        
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        
       
 Title="windowShell">
    <Grid>


        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />


        </Grid.ColumnDefinitions>


        <!-- Sidebar -->
        <Border Grid.Column="0"    
            BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="16,24">
                <!-- Brand -->
                <StackPanel>

                    <TextBlock Text="Domain Investment"
                           FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"/>

                    <TextBlock Text="Analyser"
                           FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"/>


                </StackPanel>

                <!--Primary Action-->


                <Button x:Name="btnNewAnalysis" Content="+  New Analysis"
                    Style="{StaticResource PrimaryButton}" Margin="0,24"
                    Click="btnNewAnalysis_Click"/>

                <!-- Nav -->
                <Button x:Name="btnNavDashboard" Content="Dashboard"
                    Style="{StaticResource sidebarNavBtn}"
                    Click="btnNavDashboard_Click"/>
                <Button x:Name="btnNavWatchlist" Content="Watchlist"
                    Style="{StaticResource sidebarNavBtn}"
                    Click="btnNavWatchlist_Click"/>
                <Button x:Name="btnNavSession" Content="Session"
                    Style="{StaticResource sidebarNavBtn}"
                    Click="btnNavSession_Click"/>


            </StackPanel>




        </Border>


        <!--Main Area-->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!--Top nav bar-->
            <Border Grid.Row="0" Padding="32,18"
                BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,0,0,1">
               
                    <!--Collapsed until a sesseion is active -->

                <Border x:Name="pipelineStepper" Visibility="Collapsed"
                        Background="{StaticResource StepPanelBrush}"
                        BorderBrush="{StaticResource StepRailBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="16,10">
                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <local:pipeLineStep x:Name="stepImport" Grid.Column="0"
                                            Style="{StaticResource pipelineStepStyle}"
                                            stepNumber="1" label="Import" state="Active"
                                            Cursor="Hand" MouseLeftButtonUp="stepImport_Click"/>
                        
                        <Border x:Name="rail1" Grid.Column="1" Height="1" Margin="12,0"
                     VerticalAlignment="Center" Background="{StaticResource StepRailBrush}"/>


                        <local:pipeLineStep x:Name="stepValidate" Grid.Column="2"
                                Style="{StaticResource pipelineStepStyle}"
                                stepNumber="2" label="Validate" state="Locked"/>

                        <Border x:Name="rail2" Grid.Column="3" Height="1" Margin="12,0"
                     VerticalAlignment="Center" Background="{StaticResource StepRailBrush}"/>


                        <local:pipeLineStep x:Name="stepAnalyse" Grid.Column="4"
                                            Style="{StaticResource pipelineStepStyle}"
                                            stepNumber="3" label="Analyse" state="Locked"/>




                    </Grid>
                    
                </Border>
                
                   
            </Border>
         
                
                
                
                
                
                
                <!-- Swappable content region -->
            <ContentControl x:Name="contentHost" Grid.Row="1"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"/>




        </Grid>




    </Grid>






   
</Window>
